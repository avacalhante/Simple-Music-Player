<?xml version="1.0" encoding="utf-8"?>
<!-- Listening analytics stays on this device, so it is not uploaded by Android's auto backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="analytics.db" />
        <exclude
            domain="database"
            path="analytics.db-shm" />
        <exclude
            domain="database"
            path="analytics.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="analytics.db" />
        <exclude
            domain="database"
            path="analytics.db-shm" />
        <exclude
            domain="database"
            path="analytics.db-wal" />
    </device-transfer>
</data-extraction-rules>
